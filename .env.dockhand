# SubSense Environment Configuration (Dockhand)

# --- Core (mandatory) ---
PORT=3100
HOST=0.0.0.0
SUBSENSE_ENCRYPTION_KEY=

# --- Core (optional) ---
# SUBSENSE_BASE_URL=https://subtitles.yourdomain.com
LOG_LEVEL=info

# --- Cluster ---
WEB_CONCURRENCY=3
NODE_OPTIONS=--max-old-space-size=768

# --- WARP proxy ---
WARP_ENABLED=true
# WARP_LICENSE_KEY=

# --- Provider selection (optional, defaults to all) ---
# SUBTITLE_SOURCES=wyzie,betaseries,yify,tvsubtitles,subsource,subdl,animetosho,opensubtitles,gestdown

# --- Provider API keys ---
# WYZIE_API_KEYS=
# WYZIE_SOURCES=
# BETASERIES_API_KEY=

# --- Storage: three files, separate lock domains ---
CACHE_DB_PATH=/app/data/subsense-cache.db
STATS_DB_PATH=/app/data/subsense-stats.db
META_DB_PATH=/app/data/subsense-meta.db
# L2_TTL_DAYS=7

# --- Redis ---
REDIS_URL=redis://subsense-redis:6379
# L1_TTL_HOURS=6
# L1_STALE_AFTER_HOURS=2

# --- Stats (optional) ---
# STATS_ENABLED=minimal
